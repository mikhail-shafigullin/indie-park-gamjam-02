; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Indie Park Game Jam 5"
run/main_scene="uid://bcdvgc0cs5t0u"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

MainEventBus="*uid://ci3tpwj4uurlp"
BetterTerrain="*uid://dsr73uwcp7q5j"
LevelContainer="*uid://dv7g5tcevfqyn"
PuzzleStates="*res://autoload/PuzzleStates.gd"
Dialogic="*uid://ds2q0uclmolvu"
Global="*uid://cpgxeuwd2s0bx"
Analytics="*uid://bbt6jf8icf28r"
AnalyticsWrapper="*uid://b80maxgmwiucw"

[dialogic]

directories/dch_directory={
"Ann": "res://dialogues/characters/Ann.dch"
}
directories/dtl_directory={
"BathroomBathtubUse": "res://dialogues/timelines/bathroom/BathroomBathtubUse.dtl",
