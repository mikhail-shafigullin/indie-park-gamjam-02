"BathroomToiletUse": "res://dialogues/timelines/bathroom/BathroomToiletUse.dtl",
"BathroomWardrobeOpened": "res://dialogues/timelines/bathroom/BathroomWardrobeOpened.dtl",
"BedroomBoatEvents": "res://dialogues/timelines/bedroom/BedroomBoatEvents.dtl",
"BedroomItemsUse": "res://dialogues/timelines/bedroom/BedroomItemsUse.dtl",
"BedroomMirror": "res://dialogues/timelines/bedroom/BedroomMirror.dtl",
"DefaultMessages": "res://dialogues/timelines/DefaultMessages.dtl",
"MCRoomCartridge1Examine": "res://dialogues/timelines/mcRoom/MCRoomCartridge1Examine.dtl",
"MCRoomCartridgeOnFloor": "res://dialogues/timelines/mcRoom/MCRoomCartridgeOnFloor.dtl",
