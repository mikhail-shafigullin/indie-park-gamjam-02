[background arg="#000000ff" fade="1.0" wait="true"]
I climb into the boat and push off from the "shore."
[signal arg="Bedroom_BoatMoveoutFromShore"]
[background fade="1.0" wait="true"]
[end_timeline]
label boatBedroom2Used
