"MCRoomNoteDescription": "res://dialogues/timelines/mcRoom/MCRoomNoteDescription.dtl",
"MCRoomNoteOnTheBed": "res://dialogues/timelines/mcRoom/MCRoomNoteOnTheBed.dtl",
"MCRoomTVPuzzleAlreadySolved": "res://dialogues/timelines/mcRoom/MCRoomTVPuzzleAlreadySolved.dtl",
"MCRoomTVPuzzleExtractCartridge": "res://dialogues/timelines/mcRoom/MCRoomTVPuzzleExtractCartridge.dtl",
"MCRoomTVPuzzlePutCartridgeToSlot": "res://dialogues/timelines/mcRoom/MCRoomTVPuzzlePutCartridgeToSlot.dtl",
"MCRoomTVPuzzleSolved": "res://dialogues/timelines/mcRoom/MCRoomTVPuzzleSolved.dtl",
"MCRoomTVUseWithCartridge": "res://dialogues/timelines/mcRoom/MCRoomTVUseWithCartridge.dtl",
"MCRoomTVUseWithoutCartridge": "res://dialogues/timelines/mcRoom/MCRoomTVUseWithoutCartridge.dtl",
"MainHallCabinetPhoto": "res://dialogues/timelines/mainHall/MainHallCabinetPhoto.dtl",
"MainHallDoorClosed": "res://dialogues/timelines/mainHall/MainHallDoorClosed.dtl",
"MainHallEnding": "res://dialogues/timelines/mainHall/MainHallEnding.dtl",
"MainHallEntranceDoor": "res://dialogues/timelines/mainHall/MainHallEntranceDoor.dtl",
"MainHallMirror": "res://dialogues/timelines/mainHall/MainHallMirror.dtl",
"MainHallPuzzleSolved": "res://dialogues/timelines/mainHall/MainHallPuzzleSolved.dtl",
"MainHallWakeUp": "res://dialogues/timelines/mainHall/MainHallWakeUp.dtl",
"intro": "res://levels/intro/intro.dtl"
}
layout/style_directory={
"": "res://dialogues/styles/DefaultDialogueStyle.tres",
"DefaultDialogueStyle": "res://dialogues/styles/DefaultDialogueStyle.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://dialogues/styles/DefaultDialogueStyle.tres"]
layout/default_style="res://dialogues/styles/DefaultDialogueStyle.tres"
variables={
"door_color": "white",
"mcRoom": {
"cartridgeType": 0,
"isCartridgeInserted": false,
"isPuzzleSolved": false
}
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
save/autosave_delay=60.0
save/encryption_on_exports_only=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/stretch/mode="viewport"

[editor]

naming/scene_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://addons/better-terrain/plugin.cfg", "res://addons/dialogic/plugin.cfg", "res://addons/google_analytics/plugin.cfg")

