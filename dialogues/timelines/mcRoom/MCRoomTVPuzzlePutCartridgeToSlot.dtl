if {mcRoom.isCartridgeInserted} == true:
	label haveInsertedCartridge
	There’s already a cartridge in the case. I put the case back on the shelf.
	[end_timeline]
else:
	I put the cartridge into the case and put the case back on the shelf.
	[background scene="res://scenes/dialogues/DialogicBackgroundScene.tscn" arg="res://assets/cgs/CG_CartridgeBoxClosed.png" fade="0.5" wait="true"]
	[background scene="res://scenes/dialogues/DialogicBackgroundScene.tscn" arg="res://assets/cgs/CG_CartridgeBoxEmpty.png" fade="0.5" wait="true"]
	if {mcRoom.cartridgeType} == 0.0:
		[background scene="res://scenes/dialogues/DialogicBackgroundScene.tscn" arg="res://assets/cgs/CG_CartridgeBox1.png" fade="0.5" wait="true"]
	elif {mcRoom.cartridgeType} == 1.0:
		[background scene="res://scenes/dialogues/DialogicBackgroundScene.tscn" arg="res://assets/cgs/CG_CartridgeBox2.png" fade="0.5" wait="true"]
	elif {mcRoom.cartridgeType} == 2.0:
		[background scene="res://scenes/dialogues/DialogicBackgroundScene.tscn" arg="res://assets/cgs/CG_CartridgeBox3.png" fade="0.5" wait="true"]
	elif {mcRoom.cartridgeType} == 3.0:
		[background scene="res://scenes/dialogues/DialogicBackgroundScene.tscn" arg="res://assets/cgs/CG_CartridgeBox4.png" fade="0.0"]
	elif {mcRoom.cartridgeType} == 4.0:
		[background scene="res://scenes/dialogues/DialogicBackgroundScene.tscn" arg="res://assets/cgs/CG_CartridgeBox5.png" fade="0.5" wait="true"]
	elif {mcRoom.cartridgeType} == 5.0:
		[background scene="res://scenes/dialogues/DialogicBackgroundScene.tscn" arg="res://assets/cgs/CG_CartridgeBox6.png" fade="0.5" wait="true"]
	[background scene="res://scenes/dialogues/DialogicBackgroundScene.tscn" arg="res://assets/cgs/CG_CartridgeBoxClosed.png" fade="0.5" wait="true"]
	[end_timeline]